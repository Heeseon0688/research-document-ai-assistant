# Copy to .env in the project root. Never put API keys in frontend variables.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
DEMO_FALLBACK=true

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
CHROMA_PATH=./data/chroma
# Token counts, using the embedding model's tokenizer.
CHUNK_SIZE=220
CHUNK_OVERLAP=40
TOP_K=5
# Cosine similarity is not confidence. Tune on a labeled evaluation set.
MIN_SIMILARITY=0.70
MAX_UPLOAD_MB=20
MAX_FILES=10
MAX_PAGES=200
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
